    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\n\n# Get input from the previous node\ncover_letter = items[0]['json'].get('cover_letter')\n\ndef clean_cover_letter(text):\n    if not text:\n        return \"\"\n\n    # Remove Markdown formatting and unwanted characters\n    # cleaned = re.sub(r'[*#`]', '', text)            # Remove *, #, `\n    cleaned = re.sub(r'\\\\n|\\\\r|\\\\t|\\n', ' ', text) # Replace newlines and tabs with space\n    cleaned = re.sub(r'\\s+', ' ', cleaned)          # Collapse multiple spaces\n    return cleaned.strip()\n\n# Clean the input and return as new output\nreturn [{\n    \"json\": {\n        \"cleaned_cover_letter\": clean_cover_letter(cover_letter)\n    }\n}]\n"
